<Window x:Class="HerMemory.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <StackPanel Margin="26,22,26,20">
        <!-- 顶部一条 3px 的语义色：信息=强调色，警告=橙，错误=红。比放图标克制。 -->
        <Border x:Name="Accent" Height="3" Width="34" CornerRadius="2"
                HorizontalAlignment="Left" Background="{DynamicResource Accent}"/>
        <TextBlock x:Name="HeadText" Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
        <TextBlock x:Name="BodyText" Margin="0,9,0,0" FontSize="12.5" LineHeight="21"
                   TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhostButton}"
                    MinWidth="82" Visibility="Collapsed" Click="BtnCancel_Click"/>
            <Button x:Name="BtnNo" Content="不保存" Style="{StaticResource GhostButton}"
                    MinWidth="82" Margin="9,0,0,0" Visibility="Collapsed" Click="BtnNo_Click"/>
            <Button x:Name="BtnOk" Content="确定" Style="{StaticResource AccentButton}"
                    MinWidth="82" Margin="9,0,0,0" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
