<Window x:Class="HerMemory.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记忆历史" Height="620" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SnapItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaneHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="Margin" Value="14,10,0,8"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="记忆历史" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="HistoryHint" FontSize="11.5" Foreground="{DynamicResource Subtle}" Margin="0,4,0,0"
                           Text="每次在编辑器里保存都会留一个快照，可回滚。仓库在本机（不在记忆库里）。"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnSnapshot" Content="立即快照" Style="{StaticResource GhostButton}"
                        Padding="16,7,16,7" Click="BtnSnapshot_Click"/>
                <Button x:Name="BtnRestore" Content="恢复此版本" Style="{StaticResource AccentButton}"
                        Padding="18,7,18,7" Margin="10,0,0,0" Click="BtnRestore_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="快照" Style="{StaticResource PaneHeader}"/>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Hairline}" Margin="8,0,8,0"/>
                    <ListBox x:Name="SnapshotList" Background="Transparent" BorderThickness="0" Margin="6"
                             ItemContainerStyle="{StaticResource SnapItem}"
                             SelectionChanged="SnapshotList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="与当前文件的差异" Style="{StaticResource PaneHeader}"/>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Hairline}" Margin="8,0,8,0"/>
                    <TextBox x:Name="DiffBox" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5"
                             Background="Transparent" BorderThickness="0" Padding="14,10"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Foreground="{DynamicResource Ink}"/>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="2" FontSize="11" Foreground="{DynamicResource Subtle}" Margin="2,10,0,0"/>
    </Grid>
</Window>
