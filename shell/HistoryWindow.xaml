<Window x:Class="HerMemory.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记忆历史" Height="600" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="记忆历史" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="HistoryHint" FontSize="12" Foreground="#90A4AE" Margin="0,3,0,0"
                           Text="每次在编辑器里保存都会留一个快照，可回滚。仓库在本机（不在同步库里）。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="24,0,0,0">
                <Button x:Name="BtnSnapshot" Content="立即快照" Style="{StaticResource GhostButton}"
                        Padding="16,7,16,7" Click="BtnSnapshot_Click"/>
                <Button x:Name="BtnRestore" Content="恢复此版本" Style="{StaticResource AccentButton}"
                        Padding="18,7,18,7" Margin="10,0,0,0" Click="BtnRestore_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource FieldBg}"
                    BorderBrush="#CFD8DC" BorderThickness="1" Padding="6">
                <ListBox x:Name="SnapshotList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="SnapshotList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource FieldBg}"
                    BorderBrush="#CFD8DC" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="与当前文件的差异" FontSize="11.5"
                               Foreground="#90A4AE" Margin="12,8,0,4"/>
                    <TextBox x:Name="DiffBox" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5"
                             Background="Transparent" BorderThickness="0" Padding="12,8"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Foreground="{DynamicResource Ink}"/>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="2" FontSize="11.5" Foreground="#90A4AE" Margin="2,10,0,0"/>
    </Grid>
</Window>
