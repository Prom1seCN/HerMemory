<Window x:Class="HerMemory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HerMemory"
        Title="HerMemory" Height="620" Width="880"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <!-- 子页统一页头：返回键 + 标题 + 一句说明 + 发丝线 -->
        <Style x:Key="PageHeadRule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Hairline}"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
        <Style x:Key="TileIconChip" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="40,26,40,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶栏：品牌 + 版本 + 明暗开关（每一页都在，随时可切） ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 品牌标记 = 双菱叠影（与 app.ico / 托盘图标同构图）：
                     后菱暗一档、前菱亮一档，右前左后、中心距 200/1024。矢量绘制，任意 DPI 都清晰。 -->
                <Viewbox Width="30" Height="29" VerticalAlignment="Center" Stretch="Uniform">
                    <Canvas Width="630" Height="610">
                        <Polygon Points="0,305 215,0 430,305 215,610" Fill="{DynamicResource LogoBack}"/>
                        <Polygon Points="200,305 415,0 630,305 415,610" Fill="{DynamicResource LogoFront}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="HerMemory" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                <Border Background="{DynamicResource Hairline}" CornerRadius="6" Padding="7,2,7,3"
                        Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppVersion" FontSize="10" Foreground="{DynamicResource Subtle}"/>
                </Border>
                <!-- 有新版本时才出现：点开浏览器到 release 页 -->
                <Button x:Name="BtnUpdate" Style="{StaticResource LinkButton}" Visibility="Collapsed"
                        FontSize="10.5" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource Accent}" ToolTip="打开下载页" Click="BtnUpdate_Click"/>
            </StackPanel>
            <ToggleButton x:Name="ChkDark" Style="{StaticResource ThemeSwitch}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkDark_Changed" Unchecked="ChkDark_Changed"
                          ToolTip="切换深浅色" AutomationProperties.Name="切换深浅色"/>
        </Grid>

        <!-- 页面宿主：窗口被系统工作区压小时（如 1366×768@125%），整页可纵向滚动，
             而不是把底部按钮切掉。MinHeight 保证窗口够高时页面仍然铺满、居中排版不变。 -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid x:Name="PageHost"
                  Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

        <!-- ===== 主界面（托盘模式的日常页） ===== -->
        <Grid x:Name="PageHome" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部：左边状态、右上角头像。头像与安装向导同一位置（内容区右上角），
                 尺寸统一、很淡、不压任何内容；下面的常用功能仍是原来的两行三列全宽布局。 -->
            <Grid Grid.Row="0" Height="200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="44" Height="44" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource AccentSoft}"/>
                            <Ellipse x:Name="StatusHalo" Width="34" Height="34" Fill="{DynamicResource Success}" Opacity="0"/>
                            <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="{DynamicResource Subtle}"/>
                        </Grid>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HomeStatus" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}" Text="正在检查 Gateway 状态……"/>
                            <TextBlock x:Name="HomeStatusSub" FontSize="11.5" Margin="0,5,0,0"
                                       Foreground="{DynamicResource Subtle}" Text="微信通过 Gateway 连接 HerMemory"/>
                            <!-- 启停过渡：细长的青色进度条来回跑，告诉用户"在干活"，而不是卡死 -->
                            <ProgressBar x:Name="StatusProgress" Style="{StaticResource ThinProgress}"
                                         IsIndeterminate="True" Visibility="Collapsed"
                                         Width="220" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="HomeStart" Content="启动" Style="{StaticResource AccentButton}" Click="HomeCtl_Click"/>
                        <Button x:Name="HomeStop" Content="停止" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="HomeCtl_Click"/>
                        <Button x:Name="BtnRefresh" Style="{StaticResource IconButton}" Margin="10,0,0,0"
                                Click="BtnRefresh_Click" ToolTip="刷新状态" AutomationProperties.Name="刷新状态">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 17.5 7.5 A 6.5 6.5 0 1 0 18.5 13.5 M 17.5 3.5 L 17.5 8 L 13 8"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Image x:Name="GirlWatermark" Grid.Column="1" Width="200" Height="200"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Stretch="Uniform" Opacity="0.14" IsHitTestVisible="False"/>
            </Grid>

            <!-- 六宫格：日常真正会点的入口 -->
            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="常用功能" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68"/><RowDefinition Height="68"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource TileButton}" Margin="0,0,5,9"
                            AutomationProperties.Name="记忆设置" Click="LinkMemory_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 5 4.5 A 2.5 2.5 0 0 1 7.5 2 H 19 V 19 H 7.5 A 2.5 2.5 0 0 0 5 21.5 Z M 5 21.5 V 4.5 M 9 7 H 15 M 9 10.5 H 13"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="记忆设置" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="档位与记忆预算" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TileButton}" Margin="5,0,5,9"
                            AutomationProperties.Name="API 设置" Click="LinkApi_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 19.5 9 A 4.5 4.5 0 1 1 10.5 9 A 4.5 4.5 0 0 1 19.5 9 M 11.8 12.2 L 3 21 M 6.4 17.6 L 8.4 19.6 M 9 15 L 11 17"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="API 设置" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="地址、密钥与模型" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource TileButton}" Margin="5,0,0,9"
                            AutomationProperties.Name="微信绑定" Click="LinkWeixin_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 20.5 14 A 2.5 2.5 0 0 1 18 16.5 H 9.5 L 3.5 21 V 5.5 A 2.5 2.5 0 0 1 6 3 H 18 A 2.5 2.5 0 0 1 20.5 5.5 Z M 8 9.5 H 8.02 M 12 9.5 H 12.02 M 16 9.5 H 16.02"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="微信绑定" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="扫码连接与解绑" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource TileButton}" Margin="0,0,5,0"
                            AutomationProperties.Name="设置" Click="LinkSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Canvas Width="18" Height="18">
                                    <Path Data="M 1 4 H 17 M 1 9 H 17 M 1 14 H 17" Stroke="{DynamicResource Accent}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="4" Canvas.Top="2" Width="4" Height="4" Fill="{DynamicResource Accent}"/>
                                    <Ellipse Canvas.Left="10.5" Canvas.Top="7" Width="4" Height="4" Fill="{DynamicResource Accent}"/>
                                    <Ellipse Canvas.Left="6.5" Canvas.Top="12" Width="4" Height="4" Fill="{DynamicResource Accent}"/>
                                </Canvas>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="每日新对话" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource TileButton}" Margin="5,0,5,0"
                            AutomationProperties.Name="体检" Click="LinkHealth_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 2 12 H 6 L 8.5 5.5 L 12 18.5 L 14.5 12 H 22"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="体检" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="检查并修复问题" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnResetAi" Grid.Row="1" Grid.Column="2" Style="{StaticResource TileButton}" Margin="5,0,0,0"
                            AutomationProperties.Name="重置 AI" Click="BtnResetAi_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 4 12 A 8 8 0 1 0 6.3 6.3 M 4 4.5 V 9 H 8.5"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="重置 AI" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="清空记忆并恢复出厂" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 动作行：编辑记忆是首页唯一的主按钮 -->
            <Grid Grid.Row="2" Margin="0,22,0,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButton}" Click="BtnEditor_Click"
                            AutomationProperties.Name="编辑记忆">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 3.5 20.5 L 4.4 16.4 L 15.6 5.2 A 2.3 2.3 0 0 1 18.8 8.4 L 7.6 19.6 Z"/>
                            <TextBlock Text="编辑记忆" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="一键导出" Style="{StaticResource GhostButton}"
                            Margin="9,0,0,0" VerticalAlignment="Center" Click="BtnExport_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="常用命令" Style="{StaticResource GhostButton}" Click="BtnCommands_Click"/>
                    <Button Content="使用文档" Style="{StaticResource GhostButton}" Margin="9,0,0,0" Click="BtnGuide_Click"/>
                    <Button Content="打开记忆库" Style="{StaticResource GhostButton}" Margin="9,0,0,0" Click="BtnVault_Click"/>
                    <Button Content="卸载" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="BtnUninstall_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="HomeFooter" Grid.Row="4" Style="{StaticResource Hint}" Margin="2,20,0,0"/>
        </Grid>

        <!-- ===== 首次启动：三步配置（安装器只负责装，配置全在应用里） ===== -->
        <Grid x:Name="PageSetup" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="三步，把 AI 接到微信" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                           Text="配置只在这里做一次，之后的对话都在微信里。"/>
                <Border Style="{StaticResource PageHeadRule}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                            <TextBlock Text="1" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="连接 AI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock x:Name="SetupApiStatus" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Subtle}" Text="检查中……"/>
                        </StackPanel>
                        <Button x:Name="BtnSetupApi" Grid.Column="2" Content="去设置" Style="{StaticResource GhostButton}"
                                VerticalAlignment="Center" Click="BtnSetupApi_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                            <TextBlock Text="2" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="绑定微信" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock x:Name="SetupWxStatus" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Subtle}" Text="检查中……"/>
                        </StackPanel>
                        <Button x:Name="BtnSetupWx" Grid.Column="2" Content="去绑定" Style="{StaticResource GhostButton}"
                                VerticalAlignment="Center" Click="BtnSetupWx_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentSoft}"
                                VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock Text="3" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="在微信里发第一句话" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18"
                                       Foreground="{DynamicResource Subtle}"
                                       Text="第一次对话它会问你几个问题，并写下第一份记忆。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="BtnSetupDone" Content="开始使用" Style="{StaticResource AccentButton}"
                                        Click="BtnSetupDone_Click"/>
                                <Button x:Name="BtnSetupSkip" Content="稍后再说" Style="{StaticResource LinkButton}"
                                        Margin="12,0,0,0" VerticalAlignment="Center" Click="BtnSetupSkip_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===== 主界面子页：记忆设置 ===== -->
        <Grid x:Name="PageMemory" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Button Style="{StaticResource BackButton}" Content="返回" HorizontalAlignment="Left" Click="BtnBack_Click"/>
                    <TextBlock Text="记忆设置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="MEMORY.md 与 USER.md 的字符上限。"/>
                    <Border Style="{StaticResource PageHeadRule}"/>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="记忆预算" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>


                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MEMORY 字符上限" Style="{StaticResource Label}" Margin="2,0,0,7"/>
                                    <TextBox x:Name="MemLimitBox" Style="{StaticResource FieldBox}" Width="150"
                                             TextAlignment="Left" MaxLength="7" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="USER 字符上限" Style="{StaticResource Label}" Margin="2,0,0,7"/>
                                    <TextBox x:Name="UserLimitBox" Style="{StaticResource FieldBox}" Width="150"
                                             TextAlignment="Left" MaxLength="7" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="常用档位" FontSize="12" Foreground="{DynamicResource Subtle}"
                                           VerticalAlignment="Center" Margin="2,0,10,0"/>
                                <Button Content="紧凑 2200 / 1375" Style="{StaticResource GhostButton}"
                                        Tag="2200|1375" Click="MemoryPreset_Click" Padding="12,0" MinHeight="30"/>
                                <Button Content="标准 5000 / 3000" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Tag="5000|3000" Click="MemoryPreset_Click" Padding="12,0" MinHeight="30"/>
                                <Button Content="详细 10000 / 5000" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Tag="10000|5000" Click="MemoryPreset_Click" Padding="12,0" MinHeight="30"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
