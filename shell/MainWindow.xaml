<Window x:Class="HerMemory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HerMemory" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="PageGrid" TargetType="Grid"/>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style x:Key="Slogan" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="RadioTile" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="56,44,56,36">
        <!-- 女孩图标：右上角，随主题切换（深=白线稿/浅=黑线稿；均全透明底——窗口背景透出，与软件背景永远同色；logo 嵌入色两版一致） -->
        <Image x:Name="GirlIcon" Width="198" Height="198" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-20,-36,0" Stretch="Uniform"/>
        <!-- ===== 主界面（托盘模式的日常页） ===== -->
        <Grid x:Name="PageHome" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,6,0,0">
                <TextBlock FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,0,0,14">HerMemory. <Run Foreground="{DynamicResource Accent}">Your memory.</Run></TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="HomeStatus" Margin="0,22,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Text="正在检查 Gateway 状态……"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="微信通过 Gateway 连接 HerMemory。"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button x:Name="HomeStart" Content="启动" Style="{StaticResource AccentButton}" Click="HomeCtl_Click"/>
                    <Button x:Name="HomeStop" Content="停止" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="HomeCtl_Click"/>
                    <Button x:Name="BtnRefresh" Content="刷新" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="BtnRefresh_Click"/>
                    <Button Content="一键导出" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="BtnExport_Click"/>
                    <Button Content="卸载" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="BtnUninstall_Click"/>
                </StackPanel>
                <!-- 第二行：设置类（记忆 / API / 微信绑定 / 同步服务子页） -->
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Content="记忆设置" Style="{StaticResource GhostButton}" Click="LinkMemory_Click"/>
                    <Button Content="API 设置" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="LinkApi_Click"/>
                    <Button Content="微信绑定" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="LinkWeixin_Click"/>
                    <Button Content="WebDAV 同步服务" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="LinkWebdav_Click"/>
                </StackPanel>
                <!-- 第三行：内容类（文档 / 同步库）+ 主题切换 -->
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Content="打开使用文档" Style="{StaticResource GhostButton}" Click="BtnGuide_Click"/>
                    <Button Content="打开同步库" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="BtnVault_Click"/>
                    <Button Content="安装向导" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="BtnWizard_Click"/>
                    <Button x:Name="BtnTheme" Width="36" Height="36" Margin="14,0,0,0" Click="BtnTheme_Click" Cursor="Hand" Background="{DynamicResource FieldBg}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E0F7FA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="ThemeGlyph" Text="☀" FontSize="16" Foreground="{DynamicResource Accent}"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="HomeFooter" Style="{StaticResource Body}" Foreground="#B0BEC5" Margin="0,26,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ===== 主界面子页：记忆设置 ===== -->
        <Grid x:Name="PageMemory" Visibility="Collapsed">
            <StackPanel>
                <Button Content="← 返回" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,6,14,6" Click="BtnBack_Click"/>
                <TextBlock Text="记忆设置" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,18,0,0"/>
                <TextBlock Style="{StaticResource Label}" Margin="0,44,0,0" Text="记忆档位"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="紧凑" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="标准" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="详细" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="自定义" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEMORY" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierM1" Grid.Row="1" Grid.Column="1" Text="2200" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierM2" Grid.Row="1" Grid.Column="2" Text="5000" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierM3" Grid.Row="1" Grid.Column="3" Text="10000" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierM4" Grid.Row="1" Grid.Column="4" Text="/" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="USER" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierU1" Grid.Row="2" Grid.Column="1" Text="1375" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierU2" Grid.Row="2" Grid.Column="2" Text="3000" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierU3" Grid.Row="2" Grid.Column="3" Text="5000" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierU4" Grid.Row="2" Grid.Column="4" Text="/" FontSize="12.5" Foreground="#546E7A"/>
                </Grid>
                <TextBlock x:Name="HomeTierCurrent" Margin="0,10,0,0" FontSize="12.5" Foreground="#546E7A"/>
                                <TextBlock Style="{StaticResource Body}" Foreground="#B0BEC5" Margin="0,18,0,0"
                           Text="档位修改请与 AI 对话，修改后开启新对话生效。"/>
            </StackPanel>
        </Grid>

        <!-- ===== 主界面子页：API 设置 ===== -->
        <Grid x:Name="PageApi" Visibility="Collapsed">
            <StackPanel>
                <Button Content="← 返回" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,6,14,6" Click="BtnBack_Click"/>
                <TextBlock Text="API 设置" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,18,0,0"/>
                <TextBlock Style="{StaticResource Label}" Margin="0,44,0,0" Text="修改后需停止并重新启动 Gateway 生效。"/>
                <TextBlock Style="{StaticResource Body}" Text="API 地址"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CfgUrl" Style="{StaticResource FieldBox}" TextChanged="CfgUrl_TextChanged"/>
                    <Button x:Name="CfgCheck" Grid.Column="1" Content="检测" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="18,7,18,7" VerticalAlignment="Center" Click="CfgCheck_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="API Key"/>
                <TextBox x:Name="CfgKey" Style="{StaticResource FieldBox}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="CfgFetchModels" Content="获取模型列表" Style="{StaticResource GhostButton}" Padding="16,6,16,6" Click="CfgFetchModels_Click"/>
                    <ComboBox x:Name="CfgModelCombo" MinWidth="260" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CfgSave" Content="保存" Style="{StaticResource AccentButton}" Padding="20,7,20,7" Click="CfgSave_Click"/>
                    <TextBlock x:Name="CfgHint" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="#90A4AE"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== 主界面子页：WebDAV 同步服务 ===== -->
        <Grid x:Name="PageWebdav" Visibility="Collapsed">
            <StackPanel>
                <Button Content="← 返回" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,6,14,6" Click="BtnBack_Click"/>
                <TextBlock Text="WebDAV 同步服务" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,18,0,0"/>
                <TextBlock x:Name="WebDavStatus" Margin="0,44,0,0" FontSize="13" Foreground="#546E7A" Text="检测中……"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="启停请与 AI 对话。"/>
                <TextBlock Style="{StaticResource Body}" Foreground="#B0BEC5" Margin="0,18,0,0"
                           Text="同步即备份，删除会随同步传播。"/>
            </StackPanel>
        </Grid>

        <!-- ===== 主界面子页：微信绑定 ===== -->
        <Grid x:Name="PageWeixin" Visibility="Collapsed">
            <StackPanel>
                <Button Content="← 返回" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,6,14,6" Click="BtnBack_Click"/>
                <TextBlock Text="微信绑定" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,18,0,0"/>
                <TextBlock x:Name="WxBindStatus" Style="{StaticResource Body}" Margin="0,30,0,0" Text="检测中……"/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="BtnWxBind" Content="绑定微信" Style="{StaticResource AccentButton}" Padding="20,7,20,7" Click="BtnWxBind_Click"/>
                    <Button x:Name="BtnWxUnbind" Content="解绑" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="20,7,20,7" Click="BtnWxUnbind_Click"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Body}" Foreground="#B0BEC5" Margin="0,26,0,0"
                           Text="一个微信同时只能绑定一台设备，最后扫码者生效；被顶掉的设备可随时重新绑定夺回。绑定与解绑不影响本机记忆与文档。"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页 1：欢迎 / 预检 ===== -->
        <Grid x:Name="PageWelcome">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,0,0,14">HerMemory. <Run Foreground="{DynamicResource Accent}">Your memory.</Run></TextBlock>
            <StackPanel Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Body}" Text="即将安装 Hermes 内核、记忆库与微信接入。全部资源已内置，无需联网。"/>
                <TextBlock Style="{StaticResource Body}" Text="安装完成后，AI 将接入微信。全部记忆为纯文本文件，可随时查看、修改与迁移。"/>
                <TextBlock x:Name="PrecheckStatus" Margin="0,18,0,0" FontSize="13" Foreground="#78909C" Text="正在检查环境……"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,0">
                <Button x:Name="BtnStart" Content="开始安装" Style="{StaticResource AccentButton}" IsEnabled="False" Click="BtnStart_Click"/>
                <Button Content="查看安装说明" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Click="BtnDocs_Click"/>
                <Button Content="卸载 HerMemory" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Click="BtnUninstall_Click"/>
            </StackPanel>
            <TextBlock Grid.Row="4" Margin="0,14,0,0" FontSize="11.5" Foreground="#B0BEC5"
                       Text="符号链接需要开发者模式或管理员权限，以管理员身份运行可免去设置。"/>
        </Grid>

        <!-- ===== 页 2：参数收集 ===== -->
        <Grid x:Name="PageParams" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="请选择记忆档位" Style="{StaticResource Label}"/>
                <Grid Margin="0,6,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/><ColumnDefinition Width="104"/><ColumnDefinition Width="104"/><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <RadioButton x:Name="Tier1" Grid.Row="0" Grid.Column="1" Content="紧凑" GroupName="tier" IsChecked="True" FontSize="13" Margin="0,0,0,4" Cursor="Hand" Foreground="{DynamicResource Ink}" Checked="Tier_Checked"/>
                    <RadioButton x:Name="Tier2" Grid.Row="0" Grid.Column="2" Content="标准" GroupName="tier" FontSize="13" Margin="0,0,0,4" Cursor="Hand" Foreground="{DynamicResource Ink}" Checked="Tier_Checked"/>
                    <RadioButton x:Name="Tier3" Grid.Row="0" Grid.Column="3" Content="详细" GroupName="tier" FontSize="13" Margin="0,0,0,4" Cursor="Hand" Foreground="{DynamicResource Ink}" Checked="Tier_Checked"/>
                    <RadioButton x:Name="Tier4" Grid.Row="0" Grid.Column="4" Content="自定义" GroupName="tier" FontSize="13" Margin="0,0,0,4" Cursor="Hand" Foreground="{DynamicResource Ink}" Checked="Tier_Checked"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEMORY" FontSize="12.5" Foreground="#546E7A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="2200" FontSize="12.5" Foreground="#546E7A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="5000" FontSize="12.5" Foreground="#546E7A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="10000" FontSize="12.5" Foreground="#546E7A" VerticalAlignment="Center"/>
                    <TextBox x:Name="CustomMem" Grid.Row="1" Grid.Column="4" Style="{StaticResource FieldBox}" Width="130" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,3" IsEnabled="False"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="USER" FontSize="12.5" Foreground="#546E7A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="1375" FontSize="12.5" Foreground="#546E7A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="3000" FontSize="12.5" Foreground="#546E7A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="5000" FontSize="12.5" Foreground="#546E7A" VerticalAlignment="Center"/>
                    <TextBox x:Name="CustomUser" Grid.Row="2" Grid.Column="4" Style="{StaticResource FieldBox}" Width="130" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,3" IsEnabled="False"/>
                </Grid>
                <TextBlock Text="API 地址：服务商控制台的 OpenAI 兼容地址，通常以 /v1 结尾" Style="{StaticResource Label}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Style="{StaticResource FieldBox}"/>
                    <Button x:Name="BtnCheckUrl" Grid.Column="1" Content="检测" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="18,7,18,7" VerticalAlignment="Center" Click="BtnCheckUrl_Click"/>
                </Grid>
                <TextBlock Text="API Key：在服务商控制台生成" Style="{StaticResource Label}"/>
                <TextBox x:Name="KeyBox" Style="{StaticResource FieldBox}"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnModels" Content="获取模型列表" Style="{StaticResource GhostButton}" Click="BtnModels_Click"/>
                    <ComboBox Grid.Column="1" x:Name="ModelCombo" Style="{StaticResource FieldCombo}" Margin="12,0,0,0"/>
                    <Button Grid.Column="2" x:Name="BtnNext" Content="确定：开始安装" Style="{StaticResource AccentButton}" Margin="12,0,0,0" Click="BtnNext_Click"/>
                </Grid>
                <TextBlock x:Name="ParamStatus" Margin="0,12,0,0" FontSize="12.5" Foreground="#78909C"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页 3：安装进行中 ===== -->
        <Grid x:Name="PageInstall" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="InstallTitle" Text="正在安装……" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                <ProgressBar x:Name="InstallBar" Height="8" Minimum="0" Maximum="100" Margin="0,20,0,6"/>
                <TextBlock x:Name="InstallDetail" FontSize="12" Foreground="#90A4AE" TextWrapping="Wrap" MaxHeight="180"/>
                <!-- 失败原因：红字，位于「重新安装」按钮上方（按钮由代码追加到本面板末尾） -->
                <TextBlock x:Name="InstallFail" FontSize="12.5" Foreground="#C62828" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
                <!-- 中止安装：安装链若卡住（未发现的交互点 / 网络停滞），超时上限之前用户也能自己退出 -->
                <Button x:Name="BtnInstallAbort" Content="中止安装" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,7,16,7"
                        Visibility="Collapsed" Click="BtnInstallAbort_Click"/>
            </StackPanel>
            <!-- 轮换提示：固定窗口底部、灰色弱化——与安装器真实输出物理分离，不再混淆 -->
            <TextBlock x:Name="InstallTip" Grid.Row="1" FontSize="11.5" Foreground="#B0BEC5" TextWrapping="Wrap" Margin="0,0,0,2"/>
        </Grid>

        <!-- ===== 页 4：微信扫码 ===== -->
        <Grid x:Name="PageQr" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="连接微信" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="QrStatus" Style="{StaticResource Body}" Margin="0,14,0,0"
                           Text="正在拉起微信接入。浏览器将打开二维码页面，请用微信扫码并确认。"/>
                <TextBlock x:Name="QrHint" Style="{StaticResource Body}" Foreground="#90A4AE" Margin="0,10,0,0"
                           Text="二维码 8 分钟内有效。链接过期或需更换时，点「重新扫码」重新生成并在浏览器打开。"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button x:Name="BtnQrRetry" Content="重新扫码" Style="{StaticResource GhostButton}" Click="BtnQrRetry_Click"/>
                    <Button x:Name="BtnQrSkip" Content="跳过" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="BtnQrSkip_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== 页 6：卸载 ===== -->
        <Grid x:Name="PageUninstall" Visibility="Collapsed">
            <StackPanel>
                <Button x:Name="BtnUninsBack" Content="← 返回" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,6,14,6" Click="BtnUninsCancel_Click"/>
                <TextBlock Text="卸载 HerMemory" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,18,0,0"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,30,0,0"
                           Text="将移除：Hermes 内核与全部配置、微信接入凭据、gateway 计划任务与登录项、托盘开机自启注册表、偏好设置。配置目录为 %LOCALAPPDATA%\hermes。网关将先停止。"/>
                <TextBlock Style="{StaticResource Body}" Foreground="#C62828" Margin="0,10,0,0"
                           Text="vault（文档与记忆）默认保留，不在卸载范围内。"/>
                <TextBlock Style="{StaticResource Body}" Foreground="#B0BEC5" Margin="0,10,0,0"
                           Text="本程序文件（exe）不在卸载范围内，请自行删除。"/>
                <CheckBox x:Name="UninsVault" Content="同时删除 vault（文档与记忆不可恢复）"
                          Margin="0,14,0,0" FontSize="13" Foreground="#C62828"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button x:Name="BtnUninsRun" Content="执行卸载" Style="{StaticResource AccentButton}" Background="#C62828" Click="BtnUninsRun_Click"/>
                </StackPanel>
                <TextBlock x:Name="UninsStatus" Style="{StaticResource Body}" Margin="0,16,0,0"/>
                <ProgressBar x:Name="UninsBar" Height="8" Minimum="0" Maximum="100" Margin="0,10,0,0" Visibility="Collapsed"/>
                <Button x:Name="BtnUninsClose" Content="退出" Style="{StaticResource AccentButton}" Margin="0,18,0,0" Visibility="Collapsed" Click="BtnUninsDone_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页 5：完成 ===== -->
        <Grid x:Name="PageDone" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="安装完成" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="DoneText" Style="{StaticResource Body}" Margin="0,16,0,0" LineHeight="22"/>
                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button x:Name="BtnGuide" Content="打开使用文档" Style="{StaticResource GhostButton}" Click="BtnGuide_Click"/>
                    <Button Content="完成" Style="{StaticResource AccentButton}" Margin="14,0,0,0" Click="BtnFinish_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
