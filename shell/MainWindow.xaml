<Window x:Class="HerMemory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HerMemory"
        Title="HerMemory" Height="620" Width="880"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <!-- 子页统一页头：返回键 + 标题 + 一句说明 + 发丝线 -->
        <Style x:Key="PageHeadRule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Hairline}"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
        <Style x:Key="TileIconChip" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="40,26,40,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶栏：品牌 + 版本 + 明暗开关（每一页都在，随时可切） ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 品牌标记 = 双菱叠影（与 app.ico / 托盘图标同构图）：
                     后菱暗一档、前菱亮一档，右前左后、中心距 200/1024。矢量绘制，任意 DPI 都清晰。 -->
                <Viewbox Width="30" Height="29" VerticalAlignment="Center" Stretch="Uniform">
                    <Canvas Width="630" Height="610">
                        <Polygon Points="0,305 215,0 430,305 215,610" Fill="{DynamicResource LogoBack}"/>
                        <Polygon Points="200,305 415,0 630,305 415,610" Fill="{DynamicResource LogoFront}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="HerMemory" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                <Border Background="{DynamicResource Hairline}" CornerRadius="6" Padding="7,2,7,3"
                        Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppVersion" FontSize="10" Foreground="{DynamicResource Subtle}"/>
                </Border>
                <!-- 有新版本时才出现：点开浏览器到 release 页 -->
                <Button x:Name="BtnUpdate" Style="{StaticResource LinkButton}" Visibility="Collapsed"
                        FontSize="10.5" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource Accent}" ToolTip="打开下载页" Click="BtnUpdate_Click"/>
            </StackPanel>
            <ToggleButton x:Name="ChkDark" Style="{StaticResource ThemeSwitch}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkDark_Changed" Unchecked="ChkDark_Changed"
                          ToolTip="切换深浅色" AutomationProperties.Name="切换深浅色"/>
        </Grid>

        <!-- 页面宿主：窗口被系统工作区压小时（如 1366×768@125%），整页可纵向滚动，
             而不是把底部按钮切掉。MinHeight 保证窗口够高时页面仍然铺满、居中排版不变。 -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid x:Name="PageHost"
                  MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

        <!-- ===== 主界面（托盘模式的日常页） ===== -->
        <Grid x:Name="PageHome" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 水印：右下角，低到只提供一点层次 -->
            <Image x:Name="GirlWatermark" Grid.RowSpan="5" Width="300" Height="300"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-74,-108"
                   Stretch="Uniform" Opacity="0.06" IsHitTestVisible="False"/>

            <!-- 状态卡：一眼看到 AI 在不在线，右边就是它的开关 -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Background="{DynamicResource HeroWash}"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="38" Height="38">
                            <Ellipse Fill="{DynamicResource AccentSoft}"/>
                            <Ellipse x:Name="StatusHalo" Width="30" Height="30" Fill="{DynamicResource Success}" Opacity="0"/>
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource Subtle}"/>
                        </Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HomeStatus" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}" Text="正在检查 Gateway 状态……"/>
                            <TextBlock x:Name="HomeStatusSub" FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Subtle}" Text="微信通过 Gateway 连接 HerMemory"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HomeStart" Content="启动" Style="{StaticResource AccentButton}" Click="HomeCtl_Click"/>
                        <Button x:Name="HomeStop" Content="停止" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="HomeCtl_Click"/>
                        <Button x:Name="BtnRefresh" Style="{StaticResource IconButton}" Margin="10,0,0,0"
                                Click="BtnRefresh_Click" ToolTip="刷新状态" AutomationProperties.Name="刷新状态">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 17.5 7.5 A 6.5 6.5 0 1 0 18.5 13.5 M 17.5 3.5 L 17.5 8 L 13 8"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 六宫格：日常真正会点的入口 -->
            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="常用功能" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68"/><RowDefinition Height="68"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource TileButton}" Margin="0,0,5,9"
                            AutomationProperties.Name="记忆设置" Click="LinkMemory_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 5 4.5 A 2.5 2.5 0 0 1 7.5 2 H 19 V 19 H 7.5 A 2.5 2.5 0 0 0 5 21.5 Z M 5 21.5 V 4.5 M 9 7 H 15 M 9 10.5 H 13"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="记忆设置" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="档位与记忆预算" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TileButton}" Margin="5,0,5,9"
                            AutomationProperties.Name="API 设置" Click="LinkApi_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 19.5 9 A 4.5 4.5 0 1 1 10.5 9 A 4.5 4.5 0 0 1 19.5 9 M 11.8 12.2 L 3 21 M 6.4 17.6 L 8.4 19.6 M 9 15 L 11 17"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="API 设置" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="地址、密钥与模型" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource TileButton}" Margin="5,0,0,9"
                            AutomationProperties.Name="微信绑定" Click="LinkWeixin_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 20.5 14 A 2.5 2.5 0 0 1 18 16.5 H 9.5 L 3.5 21 V 5.5 A 2.5 2.5 0 0 1 6 3 H 18 A 2.5 2.5 0 0 1 20.5 5.5 Z M 8 9.5 H 8.02 M 12 9.5 H 12.02 M 16 9.5 H 16.02"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="微信绑定" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="扫码连接与解绑" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource TileButton}" Margin="0,0,5,0"
                            AutomationProperties.Name="设置" Click="LinkSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Canvas Width="18" Height="18">
                                    <Path Data="M 1 4 H 17 M 1 9 H 17 M 1 14 H 17" Stroke="{DynamicResource Accent}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="4" Canvas.Top="2" Width="4" Height="4" Fill="{DynamicResource Accent}"/>
                                    <Ellipse Canvas.Left="10.5" Canvas.Top="7" Width="4" Height="4" Fill="{DynamicResource Accent}"/>
                                    <Ellipse Canvas.Left="6.5" Canvas.Top="12" Width="4" Height="4" Fill="{DynamicResource Accent}"/>
                                </Canvas>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="每日新对话" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource TileButton}" Margin="5,0,5,0"
                            AutomationProperties.Name="体检" Click="LinkHealth_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 2 12 H 6 L 8.5 5.5 L 12 18.5 L 14.5 12 H 22"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="体检" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="检查并修复问题" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnResetAi" Grid.Row="1" Grid.Column="2" Style="{StaticResource TileButton}" Margin="5,0,0,0"
                            AutomationProperties.Name="重置 AI" Click="BtnResetAi_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileIconChip}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 4 12 A 8 8 0 1 0 6.3 6.3 M 4 4.5 V 9 H 8.5"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="重置 AI" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="清空记忆并恢复出厂" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 动作行：编辑记忆是首页唯一的主按钮 -->
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButton}" Click="BtnEditor_Click"
                            AutomationProperties.Name="编辑记忆">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 3.5 20.5 L 4.4 16.4 L 15.6 5.2 A 2.3 2.3 0 0 1 18.8 8.4 L 7.6 19.6 Z"/>
                            <TextBlock Text="编辑记忆" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="一键导出" Style="{StaticResource GhostButton}"
                            Margin="9,0,0,0" VerticalAlignment="Center" Click="BtnExport_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="使用文档" Style="{StaticResource GhostButton}" Click="BtnGuide_Click"/>
                    <Button Content="打开记忆库" Style="{StaticResource GhostButton}" Margin="9,0,0,0" Click="BtnVault_Click"/>
                    <Button Content="卸载" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="BtnUninstall_Click"/>
                </StackPanel>
            </Grid>

            <!-- 本地路径：底部一张安静的小卡，把"记忆在哪"一直摆在眼前 -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,12" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Hairline}"
                            VerticalAlignment="Top">
                        <Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Subtle}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 3 6.5 A 2 2 0 0 1 5 4.5 H 9.4 L 11.4 7 H 19 A 2 2 0 0 1 21 9 V 17.5 A 2 2 0 0 1 19 19.5 H 5 A 2 2 0 0 1 3 17.5 Z"/>
                    </Border>
                    <TextBlock x:Name="HomeFooter" Grid.Column="1" Margin="12,1,0,0"
                               Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 主界面子页：记忆设置 ===== -->
        <Grid x:Name="PageMemory" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Button Style="{StaticResource BackButton}" Content="返回" HorizontalAlignment="Left" Click="BtnBack_Click"/>
                    <TextBlock Text="记忆设置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="AI 会长期记住的内容就存在这两个文件里。档位决定它们能写多长。"/>
                    <Border Style="{StaticResource PageHeadRule}"/>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,6,20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="档位" FontSize="11" Foreground="{DynamicResource Subtle}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="紧凑" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="标准" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="详细" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="自定义" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>

                            <Border Grid.Row="1" Grid.ColumnSpan="5" Height="1" VerticalAlignment="Top"
                                    Background="{DynamicResource Hairline}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="MEMORY" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TierM1" Text="2200" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TierM2" Text="5000" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TierM3" Text="10000" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" x:Name="TierM4" Text="/" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>

                            <Border Grid.Row="2" Grid.ColumnSpan="5" Height="1" VerticalAlignment="Top"
                                    Background="{DynamicResource Hairline}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="USER" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TierU1" Text="1375" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TierU2" Text="3000" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TierU3" Text="5000" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" x:Name="TierU4" Text="/" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>

                            <Border Grid.Row="3" Grid.ColumnSpan="5" Height="1" VerticalAlignment="Top"
                                    Background="{DynamicResource Hairline}"/>
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="5" x:Name="HomeTierCurrent" FontSize="11.5"
                                       Foreground="{DynamicResource Subtle}" VerticalAlignment="Center" Margin="0,11,0,6"/>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Hint}" Margin="2,14,0,0"
                               Text="数字是字符预算（约等于汉字数）。档位修改请与 AI 对话，修改后开启新对话生效。"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 主界面子页：设置（每日新对话） ===== -->
        <Grid x:Name="PageSettings" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Button Style="{StaticResource BackButton}" Content="返回" HorizontalAlignment="Left" Click="BtnBack_Click"/>
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="这里放那些“设一次就不用再管”的开关。"/>
                    <Border Style="{StaticResource PageHeadRule}"/>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="每日新对话" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                       Text="到了设定时间，AI 与你的对话会重新开始：第二天从零上下文起算，避免历史越堆越长、token 越用越多。"/>
                            <CheckBox x:Name="ChkDailyNew" Content="每天自动开始新对话" Margin="0,16,0,0"
                                      Checked="ChkDailyNew_Changed" Unchecked="ChkDailyNew_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="时间" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                <TextBox x:Name="DailyTimeBox" Style="{StaticResource FieldBox}" Width="92" Margin="12,0,0,0"
                                         Text="04:00" TextAlignment="Center"/>
                                <TextBlock Text="24 小时制，建议放在你不会聊天的时段" FontSize="11.5" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button x:Name="BtnSaveSettings" Content="保存" Style="{StaticResource AccentButton}"
                                        Click="BtnSaveSettings_Click"/>
                                <TextBlock x:Name="SettingsHint" VerticalAlignment="Center" Margin="14,0,0,0"
                                           FontSize="11.5" Foreground="{DynamicResource Subtle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Hint}" Margin="2,14,0,0"
                               Text="说明：这是应用层的定时任务，网关运行时才执行；PC 关机期间错过的时间不会补跑。"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 主界面子页：体检 / 自愈 ===== -->
        <Grid x:Name="PageHealth" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Button Style="{StaticResource BackButton}" Content="返回" HorizontalAlignment="Left" Click="BtnBack_Click"/>
                <TextBlock Text="体检" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                           Text="在本机逐项检查，不调用模型。红色项会直接影响使用，橙色项是提醒。"/>
                <Border Style="{StaticResource PageHeadRule}"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="BtnHealthRefresh" Content="重新检查" Style="{StaticResource AccentButton}"
                            Click="BtnHealthRefresh_Click"/>
                    <Button Content="打开日志文件夹" Style="{StaticResource GhostButton}" Margin="9,0,0,0"
                            Click="BtnHealthLogs_Click"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="HealthScroll" Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel x:Name="HealthList"/>
            </ScrollViewer>

            <TextBlock x:Name="HealthStatus" Grid.Row="2" Style="{StaticResource Hint}" Margin="2,10,0,0"/>
        </Grid>

        <!-- ===== 主界面子页：API 设置 ===== -->
        <Grid x:Name="PageApi" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Button Style="{StaticResource BackButton}" Content="返回" HorizontalAlignment="Left" Click="BtnBack_Click"/>
                    <TextBlock Text="API 设置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="修改后可保存，需停止再启动 Gateway 生效。"/>
                    <Border Style="{StaticResource PageHeadRule}"/>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,4,20,20">
                        <StackPanel>
                            <TextBlock Text="API 地址" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CfgUrl" Style="{StaticResource FieldBox}" TextChanged="CfgUrl_TextChanged"/>
                                <Button x:Name="CfgCheck" Grid.Column="1" Content="检测" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Click="CfgCheck_Click"/>
                            </Grid>

                            <TextBlock Text="API Key" Style="{StaticResource Label}"/>
                            <local:SecretBox x:Name="CfgKey"/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="CfgFetchModels" Content="获取模型列表" Style="{StaticResource GhostButton}"
                                        Click="CfgFetchModels_Click"/>
                                <ComboBox x:Name="CfgModelCombo" Style="{StaticResource FieldCombo}" IsEditable="True"
                                          MinWidth="300" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button x:Name="CfgSave" Content="保存" Style="{StaticResource AccentButton}" Click="CfgSave_Click"/>
                                <TextBlock x:Name="CfgHint" VerticalAlignment="Center" Margin="14,0,0,0"
                                           FontSize="11.5" Foreground="{DynamicResource Subtle}" TextWrapping="Wrap" MaxWidth="440"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 主界面子页：微信绑定 ===== -->
        <Grid x:Name="PageWeixin" Visibility="Collapsed">
            <StackPanel>
                <Button Style="{StaticResource BackButton}" Content="返回" HorizontalAlignment="Left" Click="BtnBack_Click"/>
                <TextBlock Text="微信绑定" Style="{StaticResource PageTitle}"/>
                <Border Style="{StaticResource PageHeadRule}"/>

                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,18">
                    <StackPanel>
                        <TextBlock x:Name="WxBindStatus" FontSize="13.5" TextWrapping="Wrap" LineHeight="21"
                                   Foreground="{DynamicResource Ink}" Text="检测中……"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="BtnWxBind" Content="绑定微信" Style="{StaticResource AccentButton}" Click="BtnWxBind_Click"/>
                            <Button x:Name="BtnWxUnbind" Content="解绑" Style="{StaticResource GhostButton}"
                                    Margin="9,0,0,0" Click="BtnWxUnbind_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Hint}" Margin="2,16,0,0" MaxWidth="640" HorizontalAlignment="Left"
                           Text="一个微信同时只能绑定一台设备，最后扫码者生效；被顶掉的设备可随时重新绑定夺回。绑定与解绑不影响本机记忆与文档。"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页 1：欢迎 / 预检 ===== -->
        <Grid x:Name="PageWelcome">
            <StackPanel VerticalAlignment="Center">

            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H1}">HerMemory.</TextBlock>
                    <TextBlock Text="Your memory." FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{DynamicResource Accent}"/>
                </StackPanel>
                <Image x:Name="GirlIcon" Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,-2,0" Stretch="Uniform" IsHitTestVisible="False"/>
            </Grid>

            <StackPanel Margin="0,20,0,0">
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                                <Path Data="M 1 4.5 L 4 7.5 L 10.5 1" Stroke="{DynamicResource Accent}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="10" Height="8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="内核已内置，运行环境需要联网下载"
                                       FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                                <Path Data="M 1 4.5 L 4 7.5 L 10.5 1" Stroke="{DynamicResource Accent}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="10" Height="8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="记忆是纯文本文件，可随时查看、修改与迁移"
                                       FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                                <Path Data="M 1 4.5 L 4 7.5 L 10.5 1" Stroke="{DynamicResource Accent}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="10" Height="8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="安装后 AI 接入微信，随时对话"
                                       FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="2,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,3,0,0">
                        <Ellipse x:Name="PrecheckHalo" Width="16" Height="16" Fill="{DynamicResource Accent}" Opacity="0"/>
                        <Ellipse x:Name="PrecheckDot" Width="7" Height="7" Fill="{DynamicResource Subtle}"/>
                    </Grid>
                    <TextBlock x:Name="PrecheckStatus" Grid.Column="1" Margin="10,0,0,0" FontSize="12.5"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20"
                               Text="正在检查环境……"/>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button x:Name="BtnStart" Content="开始安装" Style="{StaticResource AccentButton}" IsEnabled="False" Click="BtnStart_Click"/>
                <Button Content="查看安装说明" Style="{StaticResource GhostButton}" Margin="9,0,0,0" Click="BtnDocs_Click"/>
                <Button x:Name="BtnWelcomeUninstall" Content="卸载 HerMemory" Style="{StaticResource LinkButton}"
                        Margin="14,0,0,0" VerticalAlignment="Center" Click="BtnUninstall_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                       Text="符号链接需要开发者模式或管理员权限，以管理员身份运行可免去设置。"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页 4：记忆与 AI（安装完成后配置） ===== -->
        <Grid x:Name="PageParams" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="连接 AI" Style="{StaticResource PageTitle}" Margin="0,0,0,0"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                           Text="最后两步：决定 AI 能记多长，以及它用哪个模型。"/>
                <Border Style="{StaticResource PageHeadRule}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20,4,20,18">
                        <StackPanel>
                            <TextBlock Text="记忆档位" Style="{StaticResource Label}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                <RadioButton x:Name="Tier1" Grid.Row="0" Grid.Column="1" Content="紧凑" GroupName="tier" IsChecked="True"
                                             FontSize="12" Checked="Tier_Checked"/>
                                <RadioButton x:Name="Tier2" Grid.Row="0" Grid.Column="2" Content="标准" GroupName="tier"
                                             FontSize="12" Checked="Tier_Checked"/>
                                <RadioButton x:Name="Tier3" Grid.Row="0" Grid.Column="3" Content="详细" GroupName="tier"
                                             FontSize="12" Checked="Tier_Checked"/>
                                <RadioButton x:Name="Tier4" Grid.Row="0" Grid.Column="4" Content="自定义" GroupName="tier"
                                             FontSize="12" Checked="Tier_Checked"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="MEMORY" FontSize="10.5" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="2200" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="5000" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="10000" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <TextBox x:Name="CustomMem" Grid.Row="1" Grid.Column="4" Style="{StaticResource FieldBox}" Width="110"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="USER" FontSize="10.5" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="1375" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="3000" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="5000" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <TextBox x:Name="CustomUser" Grid.Row="2" Grid.Column="4" Style="{StaticResource FieldBox}" Width="110"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False"/>
                            </Grid>

                            <TextBlock Text="API 地址" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="UrlBox" Style="{StaticResource FieldBox}"/>
                                <Button x:Name="BtnCheckUrl" Grid.Column="1" Content="检测" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Click="BtnCheckUrl_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0"
                                       Text="服务商控制台的 OpenAI 兼容地址，通常以 /v1 结尾。"/>

                            <TextBlock Text="API Key" Style="{StaticResource Label}"/>
                            <local:SecretBox x:Name="KeyBox"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0" Text="在服务商控制台生成。"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ParamStatus" Margin="2,12,0,0" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnModels" Content="获取模型列表" Style="{StaticResource GhostButton}" Click="BtnModels_Click"/>
                <ComboBox Grid.Column="1" x:Name="ModelCombo" Style="{StaticResource FieldCombo}" IsEditable="True" Margin="10,0,0,0"/>
                <Button Grid.Column="2" x:Name="BtnNext" Content="完成配置" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="BtnNext_Click"/>
            </Grid>
        </Grid>

        <!-- ===== 页 2：安装位置（仅首次安装可改；已装则只读） ===== -->
        <Grid x:Name="PageLocation" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="选择安装位置" Style="{StaticResource PageTitle}" Margin="0,0,0,0"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                           Text="程序、运行数据与记忆分开存放。安装后不可更改。"/>
                <Border Style="{StaticResource PageHeadRule}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20,2,20,16">
                        <StackPanel>
                            <TextBlock Text="程序安装位置（约 80 MB）" Style="{StaticResource Label}" Margin="2,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LocBox" Style="{StaticResource FieldBox}" TextChanged="LocBox_TextChanged"/>
                                <Button x:Name="BtnLocBrowse" Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Click="BtnLocBrowse_Click"/>
                            </Grid>

                            <TextBlock Text="数据存储位置（约 2-3 GB）" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DataBox" Style="{StaticResource FieldBox}" TextChanged="LocBox_TextChanged"/>
                                <Button x:Name="BtnDataBrowse" Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Click="BtnDataBrowse_Click"/>
                            </Grid>

                            <!-- 记忆库：第三个位置。里面是用户的文档与 AI 的五个记忆文件（明文），
                                 可以放 D 盘，也可以指向已有的文档文件夹（只会在其下建 HerMemory\）。 -->
                            <TextBlock Text="AI记忆位置" Style="{StaticResource Label}" Margin="2,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VaultBox" Style="{StaticResource FieldBox}" TextChanged="LocBox_TextChanged"/>
                                <Button x:Name="BtnVaultBrowse" Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Click="BtnVaultBrowse_Click"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,18,0,0"/>
                            <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（托盘与 AI 通道随登录启动）"
                                      Margin="0,16,0,0" IsChecked="True"/>
                            <!-- 双形态（v0.22）：浏览器与电脑操作是两个大件（Chromium ~500MB + cua-driver）。
                                 勾选状态会透传给上游安装器，并由上游记进 declined-packages.json。 -->
                            <CheckBox x:Name="ChkHeavyTools" Content="安装浏览器与电脑操作能力（约 500 MB，可稍后补装）"
                                      Margin="0,12,0,0" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="LocStatus" Margin="2,0,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnLocStart" Content="开始安装" Style="{StaticResource AccentButton}" Click="BtnLocStart_Click"/>
                    <Button Style="{StaticResource BackButton}" Content="返回" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="BtnLocBack_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== 页 3：安装进行中（跑两次：安装环境 / 配置 AI） ===== -->
        <Grid x:Name="PageInstall" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="26,22" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="InstallTitle" Text="正在安装……" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}"/>
                    <ProgressBar x:Name="InstallBar" Height="8" Minimum="0" Maximum="100" Margin="0,18,0,8"/>
                    <TextBlock x:Name="InstallDetail" FontSize="12" Foreground="{DynamicResource Muted}"
                               TextWrapping="Wrap" MaxHeight="170" LineHeight="19"/>
                    <!-- 失败原因：红字，位于「重新安装」按钮上方（按钮由代码追加到本面板末尾） -->
                    <TextBlock x:Name="InstallFail" FontSize="12.5" Foreground="{DynamicResource Danger}"
                               TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
                    <!-- 中止安装：安装链若卡住，超时上限之前用户也能自己退出 -->
                    <Button x:Name="BtnInstallAbort" Content="中止安装" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Margin="0,16,0,0"
                            Visibility="Collapsed" Click="BtnInstallAbort_Click"/>
                </StackPanel>
            </Border>
            <!-- 轮换提示：固定窗口底部、灰色弱化——与安装器真实输出物理分离，不再混淆 -->
            <TextBlock x:Name="InstallTip" Grid.Row="1" Style="{StaticResource Hint}" Margin="2,0,2,2"/>
        </Grid>

        <!-- ===== 页 5：微信扫码 ===== -->
        <Grid x:Name="PageQr" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="26,24" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="连接微信" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock x:Name="QrStatus" Style="{StaticResource Body}" Margin="0,10,0,0"
                               Text="正在拉起微信接入。浏览器将打开二维码页面，请用微信扫码并确认。"/>
                    <TextBlock x:Name="QrHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="二维码 8 分钟内有效，过期可点「重新扫码」。"/>
                    <!-- 扫码链接（2026-09-17）：沙盒等环境无法拉起浏览器时，用户仍可在应用内查看并复制 -->
                    <Border x:Name="QrLinkBox" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,10"
                            Background="{DynamicResource Hairline}" CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="QrLinkText" Grid.Column="0" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Cursor="Hand"
                                       ToolTip="点击复制" MouseLeftButtonUp="QrLinkText_MouseLeftButtonUp"/>
                            <Button x:Name="BtnCopyQrLink" Grid.Column="1" Content="复制" Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource GhostButton}" Click="BtnCopyQrLink_Click"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="BtnQrRetry" Content="重新扫码" Style="{StaticResource GhostButton}" Click="BtnQrRetry_Click"/>
                        <Button x:Name="BtnQrSkip" Content="跳过" Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                VerticalAlignment="Center" Click="BtnQrSkip_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 页 6：卸载 ===== -->
        <Grid x:Name="PageUninstall" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Button x:Name="BtnUninsBack" Style="{StaticResource BackButton}" Content="返回"
                            HorizontalAlignment="Left" Click="BtnUninsCancel_Click"/>
                    <TextBlock Text="卸载 HerMemory" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource PageHeadRule}"/>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,4,20,18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Margin="0,14,0,0" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="将移除：程序文件、Hermes 内核与全部配置、微信接入凭据、gateway 计划任务与登录项、开机自启项、桌面与开始菜单快捷方式、偏好设置。运行数据目录为 %LOCALAPPDATA%\hermes。网关将先停止。"/>
                            <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Danger}" Margin="0,10,0,0"
                                       Text="记忆库（文档与记忆）默认保留，不在卸载范围内。"/>
                            <CheckBox x:Name="UninsVault" Content="同时删除记忆库（文档与记忆不可恢复）"
                                      Margin="0,14,0,0" Foreground="{DynamicResource Danger}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button x:Name="BtnUninsRun" Content="执行卸载" Style="{StaticResource AccentButton}"
                                        Background="{DynamicResource Danger}" Click="BtnUninsRun_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="UninsStatus" Style="{StaticResource Body}" Margin="0,16,0,0"/>
                            <ProgressBar x:Name="UninsBar" Height="8" Minimum="0" Maximum="100" Margin="0,10,0,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnUninsClose" Content="退出" Style="{StaticResource AccentButton}" Margin="0,18,0,0"
                                    HorizontalAlignment="Left" Visibility="Collapsed" Click="BtnUninsDone_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 页 7：完成 ===== -->
        <Grid x:Name="PageDone" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <Border x:Name="DoneBadge" Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Left"
                        Background="{DynamicResource AccentSoft}" Margin="0,0,0,20">
                    <!-- 对勾用"均匀拉伸到固定尺寸 + 居中"画在 28x20 的盒子里。
                         旧写法是绝对坐标（M 14 29 L 23 38 L 42 18）：Path 的布局盒取几何包围盒，
                         而几何原点在 (14,29) 不归零 → 整个勾被推到左下，看起来是歪的。 -->
                    <Path Data="M 1 5.5 L 4.5 9 L 11 1.5" Stroke="{DynamicResource Accent}" StrokeThickness="2.6"
                          Width="28" Height="20" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="安装完成" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="DoneText" Style="{StaticResource Body}" Margin="0,14,0,0" LineHeight="22" MaxWidth="620" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button x:Name="BtnGuide" Content="打开使用文档" Style="{StaticResource GhostButton}" Click="BtnGuide_Click"/>
                    <Button Content="完成" Style="{StaticResource AccentButton}" Margin="9,0,0,0" Click="BtnFinish_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
