<Window x:Class="HerMemory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HerMemory" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="PageGrid" TargetType="Grid"/>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style x:Key="Slogan" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#0E7490"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="RadioTile" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="56,44,56,36">
        <!-- ===== 主界面（托盘模式的日常页） ===== -->
        <Grid x:Name="PageHome" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,6,0,0">
                <TextBlock FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,0,0,14">HerMemory. <Run Foreground="#0E7490">Your memory.</Run><LineBreak/><Run FontSize="17" FontStyle="Italic" Foreground="#0E7490">Memory that grows with you.</Run></TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="HomeStatus" Margin="0,22,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Text="正在检查 Gateway 状态……"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="微信通过 Gateway 连接 HerMemory。"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button x:Name="HomeStart" Content="启动" Style="{StaticResource AccentButton}" Click="HomeCtl_Click"/>
                    <Button x:Name="HomeStop" Content="停止" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="HomeCtl_Click"/>
                    <Button x:Name="HomeRestart" Content="重启" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="HomeCtl_Click"/>
                    <Button Content="卸载" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="BtnUninstall_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button Content="记忆设置" Style="{StaticResource GhostButton}" Click="LinkMemory_Click"/>
                    <Button Content="API 设置" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="LinkApi_Click"/>
                    <Button Content="WebDAV 同步服务" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="LinkWebdav_Click"/>
                    <Button Content="打开使用文档" Style="{StaticResource GhostButton}" Margin="24,0,0,0" Click="BtnGuide_Click"/>
                    <Button x:Name="BtnTheme" Width="36" Height="36" Margin="14,0,0,0" Click="BtnTheme_Click" Cursor="Hand" Background="{DynamicResource FieldBg}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E0F7FA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="ThemeGlyph" Text="☀" FontSize="16" Foreground="#0E7490"/>
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource Body}" Foreground="#B0BEC5" Margin="0,26,0,0"
                           Text="关闭窗口默认最小化到托盘，可在托盘菜单修改；记忆文件位于 vault\HerMemory\memory\。"/>
            </StackPanel>
        </Grid>

        <!-- ===== 主界面子页：记忆设置 ===== -->
        <Grid x:Name="PageMemory" Visibility="Collapsed">
            <StackPanel>
                <Button Content="← 返回" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,6,14,6" Click="BtnBack_Click"/>
                <TextBlock Text="记忆设置" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,18,0,0"/>
                <TextBlock Style="{StaticResource Label}" Margin="0,44,0,0" Text="记忆档位"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="紧凑" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="标准" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="详细" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="自定义" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEMORY" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierM1" Grid.Row="1" Grid.Column="1" Text="2200" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierM2" Grid.Row="1" Grid.Column="2" Text="5000" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierM3" Grid.Row="1" Grid.Column="3" Text="10000" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierM4" Grid.Row="1" Grid.Column="4" Text="/" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="USER" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierU1" Grid.Row="2" Grid.Column="1" Text="1375" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierU2" Grid.Row="2" Grid.Column="2" Text="3000" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierU3" Grid.Row="2" Grid.Column="3" Text="5000" FontSize="12.5" Foreground="#546E7A"/>
                    <TextBlock x:Name="TierU4" Grid.Row="2" Grid.Column="4" Text="/" FontSize="12.5" Foreground="#546E7A"/>
                </Grid>
                <TextBlock x:Name="HomeTierCurrent" Margin="0,10,0,0" FontSize="12.5" Foreground="#546E7A"/>
                                <TextBlock Style="{StaticResource Body}" Foreground="#B0BEC5" Margin="0,18,0,0"
                           Text="档位修改请与 AI 对话；修改后开启新对话生效。"/>
            </StackPanel>
        </Grid>

        <!-- ===== 主界面子页：API 设置 ===== -->
        <Grid x:Name="PageApi" Visibility="Collapsed">
            <StackPanel>
                <Button Content="← 返回" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,6,14,6" Click="BtnBack_Click"/>
                <TextBlock Text="API 设置" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,18,0,0"/>
                <TextBlock Style="{StaticResource Label}" Margin="0,44,0,0" Text="模型接口：仅在 Gateway 停止时可修改。"/>
                <TextBlock Style="{StaticResource Body}" Text="API 地址"/>
                <TextBox x:Name="CfgUrl" Style="{StaticResource FieldBox}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="API Key"/>
                <TextBox x:Name="CfgKey" Style="{StaticResource FieldBox}"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CfgSave" Content="保存" Style="{StaticResource AccentButton}" Padding="20,7,20,7" Click="CfgSave_Click"/>
                    <TextBlock x:Name="CfgHint" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="#90A4AE"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== 主界面子页：WebDAV 同步服务 ===== -->
        <Grid x:Name="PageWebdav" Visibility="Collapsed">
            <StackPanel>
                <Button Content="← 返回" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,6,14,6" Click="BtnBack_Click"/>
                <TextBlock Text="WebDAV 同步服务" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,18,0,0"/>
                <TextBlock x:Name="WebDavStatus" Margin="0,44,0,0" FontSize="13" Foreground="#546E7A" Text="检测中…"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="启停请直接与 AI 对话。"/>
                <TextBlock Style="{StaticResource Body}" Foreground="#B0BEC5" Margin="0,18,0,0"
                           Text="同步即备份，删除会随同步传播。"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页 1：欢迎 / 预检 ===== -->
        <Grid x:Name="PageWelcome">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,0,0,14">HerMemory. <Run Foreground="#0E7490">Your memory.</Run><LineBreak/><Run FontSize="17" FontStyle="Italic" Foreground="#0E7490">Memory that grows with you.</Run></TextBlock>
            <StackPanel Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Body}" Text="即将安装 Hermes 内核、记忆库与微信接入，约 5-10 分钟，需联网。"/>
                <TextBlock Style="{StaticResource Body}" Text="安装完成后，AI 将接入微信；全部记忆为纯文本文件，可随时查看、修改与迁移。"/>
                <TextBlock x:Name="PrecheckStatus" Margin="0,18,0,0" FontSize="13" Foreground="#78909C" Text="正在检查环境……"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,0">
                <Button x:Name="BtnStart" Content="开始安装" Style="{StaticResource AccentButton}" IsEnabled="False" Click="BtnStart_Click"/>
                <Button Content="查看安装说明" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Click="BtnDocs_Click"/>
                <Button Content="卸载 HerMemory" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Click="BtnUninstall_Click"/>
            </StackPanel>
            <TextBlock Grid.Row="4" Margin="0,14,0,0" FontSize="11.5" Foreground="#B0BEC5"
                       Text="符号链接需要开发者模式或管理员权限；以管理员身份运行可免去设置。"/>
        </Grid>

        <!-- ===== 页 2：参数收集 ===== -->
        <Grid x:Name="PageParams" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="记忆容量" Style="{StaticResource Label}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Tier1" Content="紧凑" GroupName="tier" IsChecked="True" Style="{StaticResource RadioTile}"/>
                    <RadioButton x:Name="Tier2" Content="标准" GroupName="tier" Style="{StaticResource RadioTile}"/>
                    <RadioButton x:Name="Tier3" Content="详细" GroupName="tier" Style="{StaticResource RadioTile}"/>
                </StackPanel>
                <TextBlock Text="API 地址：服务商控制台的 OpenAI 兼容地址，通常以 /v1 结尾" Style="{StaticResource Label}"/>
                <TextBox x:Name="UrlBox" Style="{StaticResource FieldBox}"/>
                <TextBlock Text="API Key：在服务商控制台生成" Style="{StaticResource Label}"/>
                <TextBox x:Name="KeyBox" Style="{StaticResource FieldBox}"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnModels" Content="获取模型列表" Style="{StaticResource GhostButton}" Click="BtnModels_Click"/>
                    <ComboBox Grid.Column="1" x:Name="ModelCombo" Style="{StaticResource FieldCombo}" Margin="12,0,0,0"/>
                    <Button Grid.Column="2" x:Name="BtnNext" Content="下一步：安装" Style="{StaticResource AccentButton}" Margin="12,0,0,0" Click="BtnNext_Click"/>
                </Grid>
                <TextBlock x:Name="ParamStatus" Margin="0,12,0,0" FontSize="12.5" Foreground="#78909C"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页 3：安装进行中 ===== -->
        <Grid x:Name="PageInstall" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="InstallTitle" Text="正在安装……" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                <ProgressBar x:Name="InstallBar" Height="8" Minimum="0" Maximum="100" Margin="0,20,0,6"/>
                <TextBlock x:Name="InstallDetail" FontSize="12" Foreground="#90A4AE" TextWrapping="Wrap" MaxHeight="180"/>
                <TextBlock x:Name="InstallTip" FontSize="12" Foreground="#0E7490" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页 4：微信扫码 ===== -->
        <Grid x:Name="PageQr" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="连接微信" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="QrStatus" Style="{StaticResource Body}" Margin="0,14,0,0"
                           Text="正在拉起微信接入……浏览器将自动打开二维码页面，请用微信扫码并确认。"/>
                <TextBlock x:Name="QrHint" Style="{StaticResource Body}" Foreground="#90A4AE"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button x:Name="BtnQrRetry" Content="重新拉起二维码" Style="{StaticResource GhostButton}" Visibility="Collapsed" Click="BtnQrRetry_Click"/>
                    <Button x:Name="BtnQrSkip" Content="暂不接入，跳过" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="BtnQrSkip_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== 页 6：卸载 ===== -->
        <Grid x:Name="PageUninstall" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="卸载 HerMemory" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,14,0,0"
                           Text="将移除：Hermes 内核与全部配置（%LOCALAPPDATA%\hermes）、微信接入凭据、gateway 计划任务与登录项、托盘开机自启注册表、偏好设置。网关会先停止。"/>
                <TextBlock Style="{StaticResource Body}" Foreground="#C62828" Margin="0,10,0,0"
                           Text="vault（文档与记忆）默认保留，不属于卸载范围。"/>
                <CheckBox x:Name="UninsVault" Content="同时删除 vault，文档与记忆不可恢复"
                          Margin="0,14,0,0" FontSize="13" Foreground="#C62828"/>
                <CheckBox x:Name="UninsExe" Content="同时删除本程序文件"
                          Margin="0,8,0,0" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button x:Name="BtnUninsRun" Content="执行卸载" Style="{StaticResource AccentButton}" Background="#C62828" Click="BtnUninsRun_Click"/>
                    <Button x:Name="BtnUninsCancel" Content="取消" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="BtnUninsCancel_Click"/>
                </StackPanel>
                <TextBlock x:Name="UninsStatus" Style="{StaticResource Body}" Margin="0,16,0,0"/>
                <ProgressBar x:Name="UninsBar" Height="8" Minimum="0" Maximum="100" Margin="0,10,0,0" Visibility="Collapsed"/>
                <Button x:Name="BtnUninsClose" Content="退出" Style="{StaticResource AccentButton}" Margin="0,18,0,0" Visibility="Collapsed" Click="BtnUninsDone_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页 5：完成 ===== -->
        <Grid x:Name="PageDone" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="安装完成" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="DoneText" Style="{StaticResource Body}" Margin="0,16,0,0" LineHeight="22"/>
                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button x:Name="BtnGuide" Content="打开使用文档" Style="{StaticResource GhostButton}" Click="BtnGuide_Click"/>
                    <Button Content="完成" Style="{StaticResource AccentButton}" Margin="14,0,0,0" Click="BtnFinish_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
