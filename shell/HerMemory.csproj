<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 发行形态（2026-09-15 拆包）：
         SetupMode=false（默认）→ 程序本体 HerMemory.exe（约 69 MB）：托盘 + 主界面 + 安装向导（无随包素材）
         SetupMode=true         → 安装器 HerMemorySetup.exe（约 254 MB）：额外内嵌「程序本体」与「最小随包素材」，
                                  负责把程序本体释放到 Program Files 并把运行时装到位
         两者是同一份代码、同一份 csproj，构建两次；用 build-release.ps1 编排。 -->
    <SetupMode Condition="'$(SetupMode)' == ''">false</SetupMode>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HerMemory</AssemblyName>
    <RootNamespace>HerMemory</RootNamespace>
    <Version>0.2.0</Version>
    <Product>HerMemory</Product>
    <AssemblyTitle>HerMemory</AssemblyTitle>
    <Company>Prom1seCN</Company>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 任务栏/窗口图标：与 exe 图标同源，但内容占画布 92%（exe 图标只有 ~60%，任务栏上显得小）。
         用 EmbeddedResource + 流加载：pack URI 在单文件/安装器形态下偶发解析失败，会静默退回小图标。 -->
    <EmbeddedResource Include="app-taskbar.ico">
      <LogicalName>app-taskbar.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- .NET 8 不自带代码页编码；安装器输出按 GBK(936) 解码需显式注册 CodePagesEncodingProvider（App 启动时） -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\*.png">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 发行版 payload 内嵌（两种形态都带）：install.ps1 + memory/docs/skins/scripts + 根部脚本/文档。
       程序本体带上它是为了：微信扫码脚本、修复安装时跑 install.ps1 的自足性。
       exe 找不到仓库目录时自动解压到 %LOCALAPPDATA%\HerMemory\payload\<版本>\ 作为安装源。
       五个目录均扁平（无子目录）；逐字节嵌入，BOM/编码与仓库文件完全一致。
       icons/、banner-preview.html、女孩设计原图为仓库/网页专用，安装流程不引用，不嵌。 -->
  <ItemGroup>
    <PayloadRoot Include="..\install.ps1;..\install.bat;..\install.sh;..\gateway-run.bat;..\export.sh;..\memory-size.sh;..\README.md;..\LICENSE" />
    <EmbeddedResource Include="@(PayloadRoot)" LogicalName="payload/%(Filename)%(Extension)" />
    <PayloadMemory Include="..\memory\**\*" />
    <EmbeddedResource Include="@(PayloadMemory)" LogicalName="payload/memory/%(Filename)%(Extension)" />
    <PayloadDocs Include="..\docs\**\*" />
    <EmbeddedResource Include="@(PayloadDocs)" LogicalName="payload/docs/%(Filename)%(Extension)" />
    <PayloadSkins Include="..\skins\**\*" />
    <EmbeddedResource Include="@(PayloadSkins)" LogicalName="payload/skins/%(Filename)%(Extension)" />
    <!-- 只打运行时脚本；__pycache__ / *.pyc 是构建机残留，不该进包 -->
    <PayloadScripts Include="..\scripts\**\*" Exclude="..\scripts\**\__pycache__\**;..\scripts\**\*.pyc" />
    <EmbeddedResource Include="@(PayloadScripts)" LogicalName="payload/scripts/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 仅安装器（SetupMode=true）：
       app/HerMemory.exe —— 程序本体，由 build-release.ps1 先发布到 build\app\ 再内嵌；
       payload/ —— 随包内核与引导器，由 build-offline.ps1 产出到 build\minimal\。
       缺任何一项都由下面的 Target 直接报错——绝不产出「看起来能装、实际装不上」的包。 -->
  <PropertyGroup Condition="'$(SetupMode)' == 'true'">
    <!-- 线上版用 build\minimal；离线版用 build\minimal-offline（build-offline.ps1 -Offline 产出） -->
    <HmPayloadDir Condition="'$(HmPayloadDir)' == ''">$(HmPayloadDir)</HmPayloadDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(SetupMode)' == 'true'">
    <SetupApp Include="..\build\app\HerMemory.exe" Condition="Exists('..\build\app\HerMemory.exe')" />
    <EmbeddedResource Include="@(SetupApp)" LogicalName="app/%(Filename)%(Extension)" />
    <!-- 随包四件（v0.22 架构）：
           hermes-agent.bundle   快照仓库的 git bundle（main = 快照提交，含 pin tag）
           hermes-agent.commit   该 bundle 的 main commit（install.ps1 用它做 -Commit 钉住）
           uv.exe                PM 的引导器（版本必须等于 pm/lock.json 的 uv pin）
           uv.version            uv 版本（install.ps1 用它算 PM store 槽位名）
         Python 3.14 / Node 26 / Chromium / PyPI 依赖全部由 PM 在安装时从官方 sha256 镜像
         与国内索引取——不再有 assets-offline 那一套 1.5 GB 素材。
         两个 .version/.commit 戳必须随包，否则安装时读不到、pin 校验与 uv 槽位都会退化。
         产出方：build-offline.ps1。 -->
    <BundledAsset Include="$(HmPayloadDir)\hermes-agent.bundle" Condition="Exists('$(HmPayloadDir)\hermes-agent.bundle')" />
    <BundledAsset Include="$(HmPayloadDir)\hermes-agent.commit" Condition="Exists('$(HmPayloadDir)\hermes-agent.commit')" />
    <BundledAsset Include="$(HmPayloadDir)\uv.exe" Condition="Exists('$(HmPayloadDir)\uv.exe')" />
    <BundledAsset Include="$(HmPayloadDir)\uv.version" Condition="Exists('$(HmPayloadDir)\uv.version')" />
    <!-- python.json：随包 CPython 的版本/sha256/uv 受管目录名。install.ps1 靠它把 Python
         解压成「已安装」布局，引导阶段零下载（死代理事故的修复）。 -->
    <BundledAsset Include="$(HmPayloadDir)\python.json" Condition="Exists('$(HmPayloadDir)\python.json')" />
    <!-- runtime.json：运行时大件的 sha256 → 原始文件名。PM 只看后缀解包，改名前必须查它。 -->
    <BundledAsset Include="$(HmPayloadDir)\runtime.json" Condition="Exists('$(HmPayloadDir)\runtime.json')" />
    <EmbeddedResource Include="@(BundledAsset)" LogicalName="payload/%(Filename)%(Extension)" />
    <!-- 运行时大件（git / python / node）：文件名就是 pm/lock.json 里的 sha256。
         安装时 install.ps1 把它们预置进 PM 的下载缓存（%LOCALAPPDATA%\hermes\tools\fetch-<sha>），
         PM 校验哈希后直接使用，不再联网下载——国内 200 KB/s 的线路最慢的就是这三个。 -->
    <RuntimeArtifact Include="$(HmPayloadDir)\artifacts\*" Condition="Exists('$(HmPayloadDir)\artifacts')" />
    <EmbeddedResource Include="@(RuntimeArtifact)" LogicalName="payload/artifacts/%(Filename)%(Extension)" />
    <!-- PM 自己运行时的 4 个 wheel（约 250 KB）：PM 引导固定走 PyPI 官方源且不吃镜像，
         国内 DNS 解析不了 files.pythonhosted.org 时安装会死在这里，随包离线装。 -->
    <PmWheel Include="$(HmPayloadDir)\pm-wheelhouse\*" Condition="Exists('$(HmPayloadDir)\pm-wheelhouse')" />
    <!-- 离线版：Python 依赖缓存（uv 的 cache 目录打包）。install.ps1 解到 <HERMES_HOME>\cache 并开 UV_OFFLINE。 -->
    <OfflineUvCache Include="$(HmPayloadDir)\uv-cache.zip" Condition="Exists('$(HmPayloadDir)\uv-cache.zip')" />
    <EmbeddedResource Include="@(OfflineUvCache)" LogicalName="payload/uv-cache.zip" />
    <EmbeddedResource Include="@(PmWheel)" LogicalName="payload/pm-wheelhouse/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 安装器的前置产物断言：条件 Exists 只会「静默不嵌」，那会得到一个空有外壳的安装器。
       这里在编译前硬失败，把问题挡在构建环节而不是用户的安装环节。 -->
  <Target Name="HmValidateSetupInputs" BeforeTargets="CoreCompile" Condition="'$(SetupMode)' == 'true'">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\build\app\HerMemory.exe')"
           Text="安装器缺少程序本体：build\app\HerMemory.exe 不存在。请用 build-release.ps1 构建（它会先发布程序本体）。" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)$(HmPayloadDir)\hermes-agent.bundle')"
           Text="安装器缺少内核 bundle：build\minimal\hermes-agent.bundle 不存在。请先运行 build-offline.ps1 -Tag v0.22.2。" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)$(HmPayloadDir)\hermes-agent.commit')"
           Text="安装器缺少内核 commit 戳：build\minimal\hermes-agent.commit 不存在。请先运行 build-offline.ps1 -Tag v0.22.2。" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)$(HmPayloadDir)\uv.exe')"
           Text="安装器缺少 uv：build\minimal\uv.exe 不存在。请先运行 build-offline.ps1 -Tag v0.22.2。" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)$(HmPayloadDir)\uv.version')"
           Text="安装器缺少 uv 版本戳：build\minimal\uv.version 不存在。请先运行 build-offline.ps1 -Tag v0.22.2。" />
    <!-- 运行时大件（git / python / node）按 sha256 命名，随包预置 PM 缓存。
         一个都没有就意味着 Setup 会退化成“全量联网下载”，国内用户会卡在 200 KB/s。 -->
    <Error Condition="'@(RuntimeArtifact)' == ''"
           Text="安装器缺少运行时大件：build\minimal\artifacts\ 为空。请先运行 build-offline.ps1 采集 git/python/node。" />
    <Error Condition="'@(PmWheel)' == ''"
           Text="安装器缺少 PM runtime wheel：build\minimal\pm-wheelhouse\ 为空。请运行 build-offline.ps1 采集。" />
    <!-- 缺 python.json 时安装器会退化成「联网下载 CPython」——那正是 2026-10-26 首装失败的原因。 -->
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)$(HmPayloadDir)\python.json')"
           Text="安装器缺少 python.json：build\minimal\python.json 不存在。请运行 build-offline.ps1（它会从 pm/lock.json 生成）。" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)$(HmPayloadDir)\runtime.json')"
           Text="安装器缺少 runtime.json：build\minimal\runtime.json 不存在。请运行 build-offline.ps1（它会把 sha256 与原始文件名对上）。" />
  </Target>

</Project>
