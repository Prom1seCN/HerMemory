<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 发行形态（2026-09-15 拆包）：
         SetupMode=false（默认）→ 程序本体 HerMemory.exe（约 69 MB）：托盘 + 主界面 + 安装向导（无随包素材）
         SetupMode=true         → 安装器 HerMemorySetup.exe（约 254 MB）：额外内嵌「程序本体」与「最小随包素材」，
                                  负责把程序本体释放到 Program Files 并把运行时装到位
         两者是同一份代码、同一份 csproj，构建两次；用 build-release.ps1 编排。 -->
    <SetupMode Condition="'$(SetupMode)' == ''">false</SetupMode>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HerMemory</AssemblyName>
    <RootNamespace>HerMemory</RootNamespace>
    <Version>0.2.0</Version>
    <Product>HerMemory</Product>
    <AssemblyTitle>HerMemory</AssemblyTitle>
    <Company>Prom1seCN</Company>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 任务栏/窗口图标：与 exe 图标同源，但内容占画布 92%（exe 图标只有 ~60%，任务栏上显得小） -->
    <Resource Include="app-taskbar.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET 8 不自带代码页编码；安装器输出按 GBK(936) 解码需显式注册 CodePagesEncodingProvider（App 启动时） -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\*.png">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 发行版 payload 内嵌（两种形态都带）：install.ps1 + memory/docs/skins/scripts + 根部脚本/文档。
       程序本体带上它是为了：微信扫码脚本、修复安装时跑 install.ps1 的自足性。
       exe 找不到仓库目录时自动解压到 %LOCALAPPDATA%\HerMemory\payload\<版本>\ 作为安装源。
       五个目录均扁平（无子目录）；逐字节嵌入，BOM/编码与仓库文件完全一致。
       icons/、banner-preview.html、女孩设计原图为仓库/网页专用，安装流程不引用，不嵌。 -->
  <ItemGroup>
    <PayloadRoot Include="..\install.ps1;..\install.bat;..\install.sh;..\gateway-run.bat;..\export.sh;..\memory-size.sh;..\README.md;..\LICENSE" />
    <EmbeddedResource Include="@(PayloadRoot)" LogicalName="payload/%(Filename)%(Extension)" />
    <PayloadMemory Include="..\memory\**\*" />
    <EmbeddedResource Include="@(PayloadMemory)" LogicalName="payload/memory/%(Filename)%(Extension)" />
    <PayloadDocs Include="..\docs\**\*" />
    <EmbeddedResource Include="@(PayloadDocs)" LogicalName="payload/docs/%(Filename)%(Extension)" />
    <PayloadSkins Include="..\skins\**\*" />
    <EmbeddedResource Include="@(PayloadSkins)" LogicalName="payload/skins/%(Filename)%(Extension)" />
    <!-- 只打运行时脚本；__pycache__ / *.pyc 是构建机残留，不该进包 -->
    <PayloadScripts Include="..\scripts\**\*" Exclude="..\scripts\**\__pycache__\**;..\scripts\**\*.pyc" />
    <EmbeddedResource Include="@(PayloadScripts)" LogicalName="payload/scripts/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 仅安装器（SetupMode=true）：
       app/HerMemory.exe —— 程序本体，由 build-release.ps1 先发布到 build\app\ 再内嵌；
       payload/ —— 随包内核与引导器，由 build-offline.ps1 产出到 build\minimal\。
       缺任何一项都由下面的 Target 直接报错——绝不产出「看起来能装、实际装不上」的包。 -->
  <ItemGroup Condition="'$(SetupMode)' == 'true'">
    <SetupApp Include="..\build\app\HerMemory.exe" Condition="Exists('..\build\app\HerMemory.exe')" />
    <EmbeddedResource Include="@(SetupApp)" LogicalName="app/%(Filename)%(Extension)" />
    <!-- 随包四件（v0.22 架构）：
           hermes-agent.bundle   快照仓库的 git bundle（main = 快照提交，含 pin tag）
           hermes-agent.commit   该 bundle 的 main commit（install.ps1 用它做 -Commit 钉住）
           uv.exe                PM 的引导器（版本必须等于 pm/lock.json 的 uv pin）
           uv.version            uv 版本（install.ps1 用它算 PM store 槽位名）
         Python 3.14 / Node 26 / Chromium / PyPI 依赖全部由 PM 在安装时从官方 sha256 镜像
         与国内索引取——不再有 assets-offline 那一套 1.5 GB 素材。
         两个 .version/.commit 戳必须随包，否则安装时读不到、pin 校验与 uv 槽位都会退化。
         产出方：build-offline.ps1。 -->
    <BundledAsset Include="..\build\minimal\hermes-agent.bundle" Condition="Exists('..\build\minimal\hermes-agent.bundle')" />
    <BundledAsset Include="..\build\minimal\hermes-agent.commit" Condition="Exists('..\build\minimal\hermes-agent.commit')" />
    <BundledAsset Include="..\build\minimal\uv.exe" Condition="Exists('..\build\minimal\uv.exe')" />
    <BundledAsset Include="..\build\minimal\uv.version" Condition="Exists('..\build\minimal\uv.version')" />
    <EmbeddedResource Include="@(BundledAsset)" LogicalName="payload/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 安装器的前置产物断言：条件 Exists 只会「静默不嵌」，那会得到一个空有外壳的安装器。
       这里在编译前硬失败，把问题挡在构建环节而不是用户的安装环节。 -->
  <Target Name="HmValidateSetupInputs" BeforeTargets="CoreCompile" Condition="'$(SetupMode)' == 'true'">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\build\app\HerMemory.exe')"
           Text="安装器缺少程序本体：build\app\HerMemory.exe 不存在。请用 build-release.ps1 构建（它会先发布程序本体）。" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\build\minimal\hermes-agent.bundle')"
           Text="安装器缺少内核 bundle：build\minimal\hermes-agent.bundle 不存在。请先运行 build-offline.ps1 -Tag v0.22.2。" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\build\minimal\hermes-agent.commit')"
           Text="安装器缺少内核 commit 戳：build\minimal\hermes-agent.commit 不存在。请先运行 build-offline.ps1 -Tag v0.22.2。" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\build\minimal\uv.exe')"
           Text="安装器缺少 uv：build\minimal\uv.exe 不存在。请先运行 build-offline.ps1 -Tag v0.22.2。" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\build\minimal\uv.version')"
           Text="安装器缺少 uv 版本戳：build\minimal\uv.version 不存在。请先运行 build-offline.ps1 -Tag v0.22.2。" />
  </Target>

</Project>
