<Window x:Class="HerMemory.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="对话" Height="800" Width="1120" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部条：只放"能改变当前状态"的三个动作。标题在左，动作在右。 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,11">
                <TextBlock Text="对话" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StateText" FontSize="11.5" VerticalAlignment="Center"
                               Margin="0,0,12,0" Foreground="{DynamicResource Subtle}" Text=""/>
                    <Button x:Name="BtnReload" Content="刷新" Style="{StaticResource GhostButton}"
                            MinHeight="30" Padding="12,0" Click="BtnReload_Click"/>
                    <Button x:Name="BtnBrowser" Content="在浏览器打开" Style="{StaticResource GhostButton}"
                            MinHeight="30" Padding="12,0" Margin="8,0,0,0" Click="BtnBrowser_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容：WebView2 占满。覆盖层只在"还没准备好"时出现，避免白屏无交代。 -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="View" Visibility="Collapsed"
                          DefaultBackgroundColor="Transparent"/>

            <Border x:Name="Overlay" Background="{DynamicResource WindowBg}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <ProgressBar x:Name="OverlayBar" IsIndeterminate="True" Width="180" Height="3"
                                 Visibility="Collapsed" Margin="0,0,0,18"/>
                    <TextBlock x:Name="OverlayTitle" Text="正在连接对话界面……"
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Ink}"/>
                    <TextBlock x:Name="OverlayText" Margin="0,8,0,0" FontSize="12" LineHeight="19"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource Muted}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="BtnRetry" Content="重试" Style="{StaticResource AccentButton}"
                                Visibility="Collapsed" Click="BtnRetry_Click"/>
                        <Button x:Name="BtnOpenBrowser2" Content="用浏览器打开" Style="{StaticResource GhostButton}"
                                Margin="9,0,0,0" Visibility="Collapsed" Click="BtnBrowser_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
